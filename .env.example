# Copy to .env.local. Without Supabase keys the app runs in demo mode
# (citizen reports stay in this browser, synced across tabs).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Public URL used in WhatsApp share messages (defaults to the current origin).
VITE_PUBLIC_URL=https://samayoon.netlify.app
# Event dataset to load (public/data/events/<slug>).
VITE_EVENT=jojdakar2026
