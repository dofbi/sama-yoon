  "lines": {
    "TER": {
      "operator": "SETER",
      "summary": "Train toutes les 8 min entre Dakar et Diamniadio (5h → 1h) annoncé pour les Jeux ; desserte de l'aéroport AIBD toutes les ~24 min depuis la mise en service de la phase 2 (28 septembre 2026).",
      "games_frequency_minutes": 8,
      "games_hours": [
        "05:00",
        "01:00"
      ],
      "regular": "Lun-sam 5h30-22h00, toutes les 10 min en pointe, 20 min en creux ; dim. toutes les 20 min de 6h30 à 22h00.",
      "fares": "Dakar → Diamniadio : 1 500 F (2de) / 2 500 F (1re).",
      "source_ids": [
        "ecofin_ter_aibd",
        "senego_ter_brt"
      ],
      "serves_venues": [
        "DAR",
        "SAW",
        "DEX",
        "CED"
      ],
      "tip": "Gare de Diamniadio : accès le plus direct vers Dakar Arena, Stade Abdoulaye Wade et le Centre des Expositions."
    },
    "BRT": {
      "operator": "Dakar Mobilité (SunuBRT)",
      "summary": "Un bus toutes les 3 à 5 min en pointe, 10 à 15 min en creux, environ 5h30-22h00. Corridor Petersen ↔ Préfecture de Guédiawaye (18 km).",
      "fares": "400 F (1 zone) · 500 F (multi-zones).",
      "source_ids": [
        "senego_ter_brt"
      ],
      "serves_venues": [
        "CID",
        "CTO"
      ],
      "tip": "Stations Grande Mosquée et Place de la Nation : à quelques minutes à pied du Complexe Iba Mar Diop."
    }
  },
